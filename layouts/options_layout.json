{
  "settings_game_version": {
    "type": "array",
    "margin": "0, 0, 0, 5",
    "content": [
      {
        "type": "group",
        "header": "Game version settings",
        "content": [
          {
            "type": "itemgrid",
            "item_width": 175,
            "item_height": 63,
            "item_margin": "2,2",
            "v_alignment": "center",
            "h_alignment": "left",
            "dropshadow": false,
            "margin": 2,
            "rows": [
              [
                "ui_only_enable_base",
                "enable_tsf"
              ],
              [
                "enable_hh",
                "enable_cc"
              ]
            ]
          },
          {
            "type": "item",
            "margin": "5, 5",
            "item": "ui_only_game_version_note"
          }
        ]
      }
    ]
  },
  "settings_level_progression": {
    "type": "array",
    "margin": "0, 0, 0, 5",
    "content": [
      {
        "type": "group",
        "header": "Level progression settings",
        "content": [
          {
            "type": "itemgrid",
            "item_width": 355,
            "item_height": 75,
            "item_margin": "2,2",
            "v_alignment": "center",
            "h_alignment": "left",
            "dropshadow": false,
            "margin": 2,
            "rows": [
              [
                "individual_level_unlock_keys"
              ],
              [
                "allow_levels_out_of_order"
              ]
            ]
          }
        ]
      }
    ]
  },
  "settings_item_pool": {
    "type": "array",
    "margin": "0, 0, 0, 0",
    "content": [
      {
        "type": "group",
        "header": "Other item pool settings",
        "content": [
          {
            "type": "itemgrid",
            "item_width": 355,
            "item_height": 75,
            "item_margin": "2,2",
            "v_alignment": "center",
            "h_alignment": "left",
            "dropshadow": false,
            "margin": 2,
            "rows": [
              [
                "basic_movement_in_pool"
