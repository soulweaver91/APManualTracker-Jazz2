  "settings_popup": {
    "type": "array",
    "orientation": "vertical",
    "v_alignment": "top",
    "min_width": 300,
    "min_height": 400,
    "margin": "0, 0",
    "content": {
      "type": "array",
      "orientation": "vertical",
      "v_alignment": "top",
      "margin": "5, 5",
      "content": [
        {
          "type": "layout",
          "key": "settings_game_version"
        },
        {
          "type": "layout",
          "key": "settings_level_progression"
        },
        {
          "type": "layout",
          "key": "settings_item_pool"
        }
      ]
    }
